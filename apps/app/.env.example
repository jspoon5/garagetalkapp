# Required for database + Drizzle
# Use your Neon non-pooler connection string.
# Keep sslmode=require on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DB_NAME?sslmode=require

# Required for sessions in production. Set any long random value in local dev too.
SESSION_SECRET=replace-with-a-long-random-string

# App runtime
NODE_ENV=development
PORT=5000

# Local admin setup
ADMIN_EMAIL=admin@garagetalk.shop
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_2FA_ENABLED=false

# GearHead AI / OpenAI
# Required for live AI responses. If omitted, GearHead AI uses safe demo fallback responses.
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional. Use https://api.openai.com/v1 for OpenAI, or another compatible base URL.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional. Defaults to gpt-4o-mini.
GEARHEAD_AI_MODEL=gpt-4o-mini

# Optional integrations (only needed if you use those features)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
