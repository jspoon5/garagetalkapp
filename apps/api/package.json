{
  "name": "@garagetalk/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --pool forks --fileParallelism=false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.0.1",
    "@garagetalk/ai": "workspace:*",
    "@garagetalk/db": "workspace:*",
    "@garagetalk/email": "workspace:*",
    "@garagetalk/shared": "workspace:*",
    "@simplewebauthn/server": "13.1.1",
    "argon2": "^0.41.1",
    "better-auth": "^1.1.14",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "livekit-server-sdk": "^2.9.1",
    "otplib": "^13.4.1",
    "pino": "^9.6.0",
    "sharp": "0.33.5",
    "stripe": "^22.5.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
