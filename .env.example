NODE_ENV=development
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://garagetalk:garagetalk@127.0.0.1:5433/garagetalk_test
DIRECT_DATABASE_URL=postgresql://garagetalk:garagetalk@127.0.0.1:5433/garagetalk_test
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=dev-only-session-secret-replace-with-64-plus-chars-xxxxxxxxxxxx
AUTH_TRUSTED_ORIGINS=http://localhost:5173
STREAM_PROVIDER=cloudflare
# Required for GearHead → Videos (Cloudflare Stream direct-creator upload):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_TOKEN=
# Optional playback host (customer-xxxx or customer-xxxx.cloudflarestream.com):
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
# Optional Stream → API webhook HMAC secret (Webhook-Signature header):
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# R2 (photos + podcast audio); account id can also satisfy Stream account if shared:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_SMART=gpt-4o
AI_MODEL_VISION=gpt-4o
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api
SMS_DAILY_BUDGET_USD=5
SMS_ALLOWED_COUNTRIES=US,CA
